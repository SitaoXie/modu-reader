include LICENSE README.md README.en.md pyproject.toml uv.lock .gitignore
include CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md CHANGELOG.md
recursive-include modu *.py *.tcss
include modu/web.html modu/web.css modu/web.js
recursive-include tests *.py
include tests/acceptance_pixels.cjs
include tests/acceptance_mouse.cjs
recursive-include tools *.py
recursive-include docs *.md
include examples/river.txt examples/first-pages.txt examples/first-pages.en.txt
include tools/render_product.cjs
include docs/images/reading-english.png docs/images/reading-chinese.png docs/images/side-by-side.png
include .github/workflows/ci.yml
global-exclude *.pyc *.pyo .DS_Store
prune test-artifacts
prune private-library
include docs/images/codex-desktop-zh.png docs/images/codex-desktop-en.png
