Screen { background: $background; color: $foreground; }
#brandbar { height: 3; padding: 0 2; background: $surface; align-vertical: middle; }
#brand { width: 18; height: 3; content-align: left middle; color: $primary; }
#tagline { width: 1fr; height: 3; content-align: left middle; color: $text-muted; }
Button { min-width: 10; height: 3; border: none; background: $surface; color: $foreground; margin: 0; }
Button:hover { background: $primary 18%; color: $primary; }
Button:focus { text-style: bold; background: $primary 18%; }
Button.-primary { background: $primary; color: $background; }
#shelf { height: 1fr; padding: 2 5; }
#shelf-title { height: 2; color: $primary; text-style: bold; }
#shelf-caption { height: 3; color: $text-muted; }
#shelf-actions { height: 3; margin-bottom: 1; }
#shelf-actions Button { width: 1fr; min-width: 8; }
#books { height: 1fr; background: $background; border: none; }
DataTable > .datatable--header { background: $surface; color: $primary; text-style: bold; }
DataTable > .datatable--cursor { background: $primary 22%; color: $foreground; }
DataTable > .datatable--odd-row { background: $surface 40%; }
#empty { height: 1fr; content-align: center middle; color: $text-muted; }
#shelf-hint { height: 2; padding-top: 1; color: $text-muted; }
#reading { height: 1fr; }
#bookbar { height: 3; padding: 0 1; align-vertical: middle; }
#bookbar Button { background: $background; }
#book-title { width: 1fr; height: 3; content-align: left middle; padding: 0 1; text-overflow: ellipsis; }
#chapter { height: 1; text-align: center; color: $text-muted; padding: 0 2; text-overflow: ellipsis; }
Reader { width: 1fr; height: 1fr; background: $background; overflow: hidden; }
#statusbar { height: 2; padding: 0 3; border-top: solid $surface; color: $text-muted; }
#progress { width: 24; height: 1; color: $primary; }
#page-progress { width: 1fr; height: 1; text-align: center; color: $foreground; }
#read-hint { width: 1fr; height: 1; text-align: right; }
#notice { overlay: screen; layer: notification; dock: bottom; height: auto; max-height: 3; padding: 0 3; background: $surface; color: $primary; }
.compact #tagline { display: none; }
.compact #brand { width: 1fr; }
.compact #bookbar Button { min-width: 8; }
.compact #bookbar #bookmarks, .compact #bookbar #settings { display: none; }
.compact #read-hint { display: none; }
.compact #progress { width: 20; }
.compact #shelf { padding: 1 2; }
ModalScreen { align: center middle; background: $background 75%; }
.dialog { width: 86; max-width: 94%; height: 80%; max-height: 36; padding: 1 2; border: round $primary; background: $background; }
.dialog-title { height: 2; color: $primary; text-style: bold; }
.dialog-hint { height: auto; max-height: 3; margin-bottom: 1; color: $text-muted; }
.dialog OptionList { height: 1fr; border: none; background: $background; padding: 0; }
.dialog OptionList > .option-list--option-highlighted { color: $foreground; background: $primary 20%; text-style: none; }
.dialog Input { margin-bottom: 1; background: $surface; border: tall $surface; }
.dialog Input:focus { border: tall $primary; }
.dialog-buttons { height: 3; align-horizontal: right; }
#file-tree { height: 1fr; background: $background; }
#help-dialog { height: auto; max-height: 94%; }
#help-text { height: auto; margin-bottom: 1; }
#confirm-book-dialog { height: auto; max-height: 90%; }
#confirm-book-title { height: auto; max-height: 4; color: $primary; margin-bottom: 1; }
#confirm-book-description { height: auto; margin-bottom: 1; }
#confirm-book-dialog Button { width: 1fr; min-width: 8; }

#reading-body { height: 1fr; }
#toc-sidebar { width: 26; height: 1fr; padding: 1 1 0 1; border-right: solid $surface; background: $background; }
#toc-heading { height: 2; color: $primary; text-style: bold; }
#chapter-progress { height: 2; color: $text-muted; text-overflow: ellipsis; }
#toc-list { height: 1fr; background: $background; border: none; padding: 0; scrollbar-size: 1 1;
    scrollbar-background: $surface; scrollbar-background-hover: $surface; scrollbar-background-active: $surface;
    scrollbar-color: $primary 40%; scrollbar-color-hover: $primary 60%; scrollbar-color-active: $primary 80%; }
#toc-list > .option-list--option-highlighted { color: $primary; background: $primary 12%; text-style: bold; }
#toc-hint { height: 2; color: $text-muted; }
ReaderRail { width: 2; height: 1fr; background: $background; }

.narrow #brand, .narrow #theme-cycle { display: none; }
